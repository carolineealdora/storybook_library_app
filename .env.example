ENV=development
PORT=9999
LOG_LEVEL=INFO

DB_HOST=localhost
# Shared DB owned by ../storybook_management_app (`make db-up migrate seed` there)
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=<redacted>
DB_NAME=storybook
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_DEBUG_MODE=false

# Required. Long random string, e.g. `openssl rand -hex 32`.
# Use a different value from storybook_management_app (ADR-011).
JWT_SECRET=<redacted>

# Comma-separated origins of the Library app (fe_storybook_library_app).
CORS_ALLOW_ORIGINS=*
