ENV=development
PORT=9999
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<redacted>
DB_NAME=storybook
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_DEBUG_MODE=false

# Required. Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=<redacted>

# Comma-separated origins of the Library and Book Management apps.
CORS_ALLOW_ORIGINS=*
